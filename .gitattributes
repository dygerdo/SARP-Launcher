# Force LF line endings for all text files
* text=auto eol=lf

# Explicit text files (always LF)
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.cjs           text eol=lf
*.mjs           text eol=lf
*.vue           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.css           text eol=lf
*.scss          text eol=lf
*.html          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.svg           text eol=lf
*.txt           text eol=lf
.env*           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.prettierrc     text eol=lf
.prettierignore text eol=lf
.eslintignore   text eol=lf

# Binary files (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.zip   binary
*.gz    binary
*.exe   binary
*.dll   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.pdf   binary
