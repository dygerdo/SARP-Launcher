{
  "name": "san-andreas-roleplay-launcher",
  "version": "1.0.0",
  "description": "San Andreas Roleplay official launcher",
  "main": "dist-electron/main.js",
  "author": "San Andreas Roleplay",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:dir": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css,json}\" \"electron/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,css,json}\" \"electron/**/*.ts\" \"*.{json,md}\"",
    "typecheck": "vue-tsc --noEmit",
    "polish": "yarn format && yarn lint && yarn typecheck",
    "reset": "node scripts/reset.cjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "pinia": "^2.2.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.1",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@primevue/themes": "^4.2.1",
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^22.7.5",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^17.6.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "3.0.0-beta.2",
    "vue-tsc": "^2.1.6"
  }
}
