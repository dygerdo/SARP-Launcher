{
  "appId": "sarp.es.launcher",
  "productName": "San Andreas Roleplay - SA:MP Launcher",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": ["dist", "dist-electron"],
  "electronLanguages": ["es-419", "en-US"],
  "extraResources": [
    {
      "from": "public/favicon.ico",
      "to": "favicon.ico"
    }
  ],
  "publish": {
    "provider": "generic",
    "url": "https://sarp-public.b-cdn.net/launcher/",
    "channel": "latest"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico",
    "artifactName": "SARP-SAMP-Launcher-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "shortcutName": "SARP Launcher",
    "differentialPackage": true,
    "deleteAppDataOnUninstall": false
  }
}
