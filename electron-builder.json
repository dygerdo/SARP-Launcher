{
  "appId": "es.sarp.launcher",
  "productName": "San Andreas Roleplay - SA:MP Launcher",
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist", "dist-electron"],
  "extraResources": [
    {
      "from": "public/favicon.ico",
      "to": "favicon.ico"
    }
  ],
  "publish": {
    "provider": "generic",
    "url": "https://sarp-public.b-cdn.net/launcher/"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico",
    "publisherName": "San Andreas Roleplay",
    "artifactName": "SARP-SAMP-Launcher-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDir": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SARP SA:MP Launcher",
    "installerIcon": "public/favicon.ico",
    "uninstallerIcon": "public/favicon.ico",
    "installerHeaderIcon": "public/favicon.ico"
  }
}
