{
  "appId": "es.sarp.launcher",
  "productName": "San Andreas Roleplay - SA:MP Launcher",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": ["dist", "dist-electron"],
  "electronLanguages": ["es-419", "en-US"],
  "extraResources": [
    {
      "from": "public/favicon.ico",
      "to": "favicon.ico"
    }
  ],
  "publish": {
    "provider": "generic",
    "url": "https://sarp-public.b-cdn.net/launcher/"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico",
    "publisherName": "San Andreas Roleplay",
    "artifactName": "SARP-SAMP-Launcher-${version}.${ext}"
  }
}
